# LLM Providers (optional - add only what you have)
OPENAI_API_KEY=

GEMINI_API_KEY=

GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1

# LM Studio (local - no API key needed)
# Set this to whatever model you loaded in LM Studio
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# MongoDB (use the Docker connection)
# NOTE: Disable retryWrites for standalone MongoDB (not a replica set)
MONGODB__URI=mongodb://localhost:27017/?retryWrites=false
MONGODB__DATABASE=agent_router_db
MONGODB__USERNAME=agentrouteradmin
MONGODB__PASSWORD=

# Fallback Configuration (last resort when all retries fail)
# This should be a reliable provider, typically local LM Studio
FALLBACK_LLM_PROVIDER=lm_studio
FALLBACK_LLM_MODEL=openai/gpt-oss-20b
FALLBACK_TEMPERATURE=0.5
FALLBACK_MAX_TOKENS=2000
FALLBACK_TOP_P=
FALLBACK_TOP_K=
FALLBACK_THINKING_BUDGET=
FALLBACK_THINKING_EFFORT=

# LLM retries
LLM_RETRY_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.0
LLM_RETRY_MAX_DELAY=10.0
LLM_RETRY_EXPONENTIAL_BASE=2.0

# Logging
LOGGING__LEVEL=INFO
LOGGING__FORMAT=json