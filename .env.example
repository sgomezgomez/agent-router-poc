# Brave Search (MCP)
BRAVE_API_KEY=

# LLM Providers (optional - add only what you have)
OPENAI_API_KEY=

GEMINI_API_KEY=

GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1

# LM Studio (local - no API key needed)
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# MongoDB (Local)
MONGODB__URI=mongodb://localhost:27017/?retryWrites=false
MONGODB__MAX_POOL_SIZE=10
MONGODB__MIN_POOL_SIZE=1
MONGODB__DATABASE=agent_router_db
MONGODB__USERNAME=agentrouteradmin
MONGODB__PASSWORD=

# Fallback Configuration (last resort when all retries fail)
# This should be a reliable provider, typically local LM Studio
FALLBACK_LLM_PROVIDER=lm_studio
FALLBACK_LLM_MODEL=zai-org/glm-4.7-flash
FALLBACK_LLM_API_MODE="responses"
FALLBACK_TEMPERATURE=1.0
FALLBACK_MAX_TOKENS=5000
FALLBACK_TOP_P=0.9
FALLBACK_TOP_K=50
FALLBACK_THINKING_BUDGET=0
FALLBACK_THINKING_EFFORT="high" # low|medium|high
FALLBACK_ENABLE_THINKING= # true|false (blank means use model registry default)
ADAPTER_DEBUG_TRACE_DEFAULT=false # true to append tool trace markdown by default when clients do not send metadata.debug_trace
LLM_DEBUG_LOGGING=false # true to log detailed LLM request/retry/fallback diagnostics

# LLM retries
LLM_RETRY_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.0
LLM_RETRY_MAX_DELAY=10.0
LLM_RETRY_EXPONENTIAL_BASE=2.0

# Logging
LOGGING__LEVEL=INFO
LOGGING__FORMAT=json
