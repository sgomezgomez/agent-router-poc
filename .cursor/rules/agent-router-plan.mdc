               model=self.model,
               messages=[{"role": "user", "content": request.prompt}],
               temperature=request.temperature or 0.7
           )
           return LLMResponse(
               text=response.choices[0].message.content,
               model=self.model,
               usage=response.usage.model_dump(),
               provider="openai"
