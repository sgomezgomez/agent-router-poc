   # agent/prompt_builder.py
   from agent_router.core.config import AgentConfig

   class PromptBuilder:
       """Builds system prompts from agent configuration."""

       def __init__(self, config: AgentConfig):
           self.config = config

       def build_system_prompt(self, available_tools: List[Dict] | None = None) -> str:
           """Build complete system prompt from config."""
           sections = []

           if self.config.background:
               sections.append(f"## Background\n{self.config.background}")

           if self.config.goal:
               sections.append(f"## Goal\n{self.config.goal}")

           if self.config.task:
               sections.append(f"## Task\n{self.config.task}")

           if available_tools:
               tools_desc = self._format_tools(available_tools)
               sections.append(f"## Available Tools\n{tools_desc}")

           if self.config.guidelines:
               sections.append(f"## Guidelines\n{self.config.guidelines}")

           if self.config.examples:
               sections.append(f"## Examples\n{self.config.examples}")

           if self.config.guardrails:
               sections.append(f"## Guardrails\n{self.config.guardrails}")

           return "\n\n".join(sections)

       def _format_tools(self, tools: List[Dict]) -> str:
           """Format tool list for prompt."""
           return "\n".join([
               f"- {tool['name']}: {tool['description']}"
               for tool in tools
           ])
