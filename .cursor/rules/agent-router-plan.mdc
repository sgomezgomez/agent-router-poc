3. Create LLM Service orchestrator
   ```python
   # llm/service.py
   from agent_router.llm.providers.base import BaseLLMProvider
   from agent_router.core.config import Settings
   from agent_router.core.errors import LLMProviderError
   from tenacity import retry, stop_after_attempt, wait_exponential

   class LLMService:
       """Orchestrates multiple LLM providers with retry and fallback."""

       def __init__(self, settings: Settings):
           self.providers: Dict[str, BaseLLMProvider] = {}
           self._load_providers(settings)
           self.default_provider = settings.default_llm_provider

       def _load_providers(self, settings: Settings):
           """Load configured providers."""
           if settings.openai_api_key:
               from agent_router.llm.providers.openai import OpenAIProvider
               self.providers["openai"] = OpenAIProvider(api_key=settings.openai_api_key)

           if settings.gemini_api_key:
               from agent_router.llm.providers.gemini import GeminiProvider
               self.providers["gemini"] = GeminiProvider(api_key=settings.gemini_api_key)

           from agent_router.llm.providers.lm_studio import LMStudioProvider
           self.providers["lm_studio"] = LMStudioProvider(base_url=settings.lm_studio_base_url)

       @retry(stop=stop_after_attempt(3), wait=wait_exponential(min=1, max=10))
       async def generate(
           self,
           prompt: str,
           provider: str | None = None,
           fallback: bool = True,
           **kwargs
       ) -> str:
           """Generate response with retry and optional fallback."""
           provider_name = provider or self.default_provider

           try:
               provider_instance = self.providers[provider_name]
               return await provider_instance.generate(prompt, **kwargs)
           except Exception as e:
               if fallback and provider_name != "lm_studio":
                   # Fallback to LM Studio
                   return await self.providers["lm_studio"].generate(prompt, **kwargs)
               raise LLMProviderError(f"All providers failed: {e}")

       async def generate_stream(self, prompt: str, provider: str | None = None, **kwargs):
           """Stream response from provider."""
           provider_name = provider or self.default_provider
           provider_instance = self.providers[provider_name]
           async for chunk in provider_instance.generate_stream(prompt, **kwargs):
               yield chunk
   ```

