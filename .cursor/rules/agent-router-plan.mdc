   ```python
   # storage/connection.py
   from motor.motor_asyncio import AsyncIOMotorClient
   from agent_router.core.config import Settings

   class MongoDBConnection:
       """Singleton MongoDB connection manager."""
       _instance = None
       _client: AsyncIOMotorClient | None = None

       def __new__(cls):
           if cls._instance is None:
               cls._instance = super().__new__(cls)
           return cls._instance

       async def connect(self, settings: Settings):
           if self._client is None:
               self._client = AsyncIOMotorClient(settings.mongodb_uri)
           return self._client[settings.mongodb_database]

       async def disconnect(self):
           if self._client:
               self._client.close()
               self._client = None
   ```

3. Create abstract base repository (implements core interface)
   ```python
   # storage/base_repository.py
   from abc import ABC
   from motor.motor_asyncio import AsyncIOMotorCollection
   from agent_router.core.interfaces import Repository
   from typing import Dict, List
   import uuid as uuid_lib

   class BaseRepository(Repository):
       """Abstract base repository with common CRUD operations."""

       def __init__(self, collection: AsyncIOMotorCollection):
           self.collection = collection

       async def create(self, data: Dict) -> str:
           """Create document with auto-generated UUID."""
           if "uuid" not in data:
               data["uuid"] = str(uuid_lib.uuid4())
           await self.collection.insert_one(data)
           return data["uuid"]

       async def find_by_id(self, uuid: str) -> Dict | None:
           """Find document by UUID."""
           return await self.collection.find_one({"uuid": uuid})

       async def find_many(self, filter: Dict, limit: int = 100) -> List[Dict]:
           """Find multiple documents."""
           cursor = self.collection.find(filter).limit(limit)
           return await cursor.to_list(length=limit)

       async def update(self, uuid: str, data: Dict) -> bool:
           """Update document by UUID."""
           result = await self.collection.update_one(
               {"uuid": uuid},
               {"$set": data}
           )
           return result.modified_count > 0
   ```

