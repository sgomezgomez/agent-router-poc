### PHASE 10: A2A Protocol

**Goal**: Support remote agents via A2A protocol using official Python SDK

**A2A Protocol Overview:**
- **Purpose**: Enable communication between independent AI agent systems
- **Transport**: JSON-RPC 2.0 over HTTP(S), also supports gRPC
- **Discovery**: Agent Cards at `/.well-known/agent-card.json`
- **Communication Patterns**: Synchronous, streaming (SSE), async (webhooks)
- **Reference**: https://a2a-protocol.org/latest/specification/

**Tasks**:
1. Create A2A models
   ```python
   # connectors/a2a/models.py
   from pydantic import BaseModel
   from typing import List, Literal, Dict, Any

   class A2AMessage(BaseModel):
       """A2A protocol message structure."""
       messageId: str
       role: Literal["user", "agent"]
       parts: List[Dict[str, Any]]  # text, file, or data parts
       contextId: str | None = None
       taskId: str | None = None

   class A2ATask(BaseModel):
       """A2A task representation."""
       id: str
       contextId: str
       status: Dict[str, str]  # state: submitted/working/completed/failed
       artifacts: List[Dict[str, Any]] | None = None

   class A2AAgentCard(BaseModel):
       """Agent Card for discovery."""
       protocolVersion: str
       name: str
       supportedInterfaces: List[Dict[str, str]]  # url, protocolBinding
       capabilities: Dict[str, bool]  # streaming, pushNotifications
       skills: List[Dict[str, Any]]  # id, name, inputModes, outputModes

   class A2AToolCall(BaseModel):
       """Wrapper for A2A agent calls."""
       agent_name: str
       message: A2AMessage
       configuration: Dict[str, Any] | None = None

   class A2AToolResult(BaseModel):
       """Result from A2A agent call."""
       success: bool
       task: A2ATask | None = None
       error: str | None = None
   ```

2. Create A2A client using official Python SDK (implements ToolConnector interface)
   ```python
   # connectors/a2a/client.py
   from agent_router.core.interfaces import ToolConnector
   from agent_router.connectors.a2a.models import (
       A2AAgentCard, A2AMessage, A2ATask, A2AToolResult
   )
   from a2a_sdk import A2AClient as SDKClient, Message, MessagePart
   from typing import Dict, List, Any
   import httpx

   class A2AClient(ToolConnector):
       """Client for communicating with remote A2A agents using official SDK.

       A2A Protocol Overview:
       - Uses JSON-RPC 2.0 over HTTP(S)
       - Agents publish capabilities via Agent Card at /.well-known/agent-card.json
       - Core methods: SendMessage, GetTask, ListTasks, CancelTask
       - Supports streaming via Server-Sent Events (SSE)
       - Supports async updates via webhooks

       Reference: https://a2a-protocol.org/latest/specification/
       """

       def __init__(self, agent_name: str, agent_config: Dict):
           self.agent_name = agent_name
           self.agent_config = agent_config
           self.base_url = agent_config["url"]
           self.client: SDKClient | None = None
           self.agent_card: A2AAgentCard | None = None

       async def connect(self, config: Dict) -> None:
           """Discover agent capabilities via Agent Card."""
           # Initialize A2A SDK client
           self.client = SDKClient(base_url=self.base_url)

           # Fetch Agent Card for capability discovery
           await self._discover_capabilities()

       async def _discover_capabilities(self):
           """Fetch Agent Card from /.well-known/agent-card.json.

           Agent Card structure:
           {
               "protocolVersion": "0.3.0",
               "name": "Example Agent",
               "supportedInterfaces": [
                   {"url": "https://agent.example.com/a2a/v1", "protocolBinding": "JSONRPC"}
               ],
               "capabilities": {"streaming": true, "pushNotifications": false},
               "skills": [{"id": "skill-1", "name": "Task Handler"}]
           }
           """
           async with httpx.AsyncClient() as http_client:
               response = await http_client.get(
                   f"{self.base_url}/.well-known/agent-card.json"
               )
               response.raise_for_status()
               card_data = response.json()
               self.agent_card = A2AAgentCard(**card_data)

       async def list_tools(self) -> List[Dict]:
           """Return agent skills as tools for LLM context.

           In A2A, 'skills' are analogous to 'tools' in MCP.
           """
           if not self.agent_card:
               return []

           return [
               {
                   "name": f"{self.agent_name}.{skill['id']}",
                   "description": skill.get("name", skill["id"]),
                   "parameters": {
                       "type": "object",
                       "properties": {
                           "message": {"type": "string", "description": "Message to send to agent"}
                       },
                       "required": ["message"]
                   },
                   "server": self.agent_name,
                   "tool_type": "a2a_agent"
               }
               for skill in self.agent_card.skills
           ]

       async def execute(self, tool_name: str, parameters: Dict) -> A2AToolResult:
           """Execute agent call via A2A protocol using SendMessage.

           A2A SendMessage request (JSON-RPC over HTTP):
           POST /v1/message:send
           Headers: A2A-Version: 0.3
           {
               "message": {
                   "messageId": "uuid",
                   "role": "user",
                   "parts": [{"text": "user query"}]
               },
               "configuration": {
                   "acceptedOutputModes": ["text/plain"]
               }
           }

           Response:
           {
               "task": {
                   "id": "task-uuid",
                   "contextId": "context-uuid",
                   "status": {"state": "completed"},
                   "artifacts": [{"artifactId": "artifact-1", "parts": [...]}]
               }
           }
           """
           if not self.client:
               return A2AToolResult(success=False, error="Not connected to A2A agent")

           try:
               # Create A2A message from parameters
               message_text = parameters.get("message", "")
               message = Message(
                   role="user",
                   parts=[MessagePart(text=message_text)]
               )

               # Send message to A2A agent
               response = await self.client.send_message(
                   message=message,
                   configuration={
                       "acceptedOutputModes": ["text/plain", "application/json"]
                   }
               )

               # Convert response to our model
               task = A2ATask(
                   id=response.task.id,
                   contextId=response.task.contextId,
                   status=response.task.status,
                   artifacts=response.task.artifacts
               )

               return A2AToolResult(success=True, task=task)

           except Exception as e:
               return A2AToolResult(success=False, error=str(e))

       async def disconnect(self):
           """Disconnect from A2A agent (cleanup)."""
           if self.client:
               await self.client.close()
   ```

3. Build example A2A server (for testing) **using Agent Layer**
   ```python
   # connectors/a2a/example_server.py
   from a2a_sdk import A2AServer, Message, Task, TaskStatus
   from agent_router.agent.base import Agent
   from agent_router.core.config import AgentConfig
   from agent_router.llm.service import LLMService
   import uvicorn

   class CalculatorAgent:
       """Example A2A agent using Agent Layer for persona management."""

       def __init__(self):
           # Use Agent Layer for consistent persona and prompting
           config = AgentConfig.from_yaml("config/agents/calculator.yaml")
           self.agent = Agent(config)
           self.llm_service = LLMService(...)

       async def handle_message(self, message: Message) -> Task:
           """Process incoming A2A message."""
           # Extract user query from message parts
           user_query = " ".join([
               part.text for part in message.parts if hasattr(part, "text")
           ])

           # Add to agent's conversation history
           self.agent.add_message("user", user_query)

           # Get response from LLM via Agent Layer
           system_prompt = self.agent.prompt_builder.build_system_prompt()
           history = self.agent.get_windowed_history()

           response = await self.llm_service.generate(
               system_prompt=system_prompt,
               messages=history,
               provider="openai"
           )

           # Store assistant response
           self.agent.add_message("assistant", response)

           # Return as A2A Task
           return Task(
               status=TaskStatus(state="completed"),
               artifacts=[{
                   "artifactId": "result-1",
                   "parts": [{"text": response}]
               }]
           )

   # Create A2A server
   async def main():
       agent = CalculatorAgent()

       # Create A2A server with Agent Card
       server = A2AServer(
           name="Calculator Agent",
           version="1.0.0",
           skills=[{
               "id": "calculate",
               "name": "Mathematical Calculator",
               "inputModes": ["text/plain"],
               "outputModes": ["text/plain"]
           }],
           capabilities={"streaming": False, "pushNotifications": False}
       )

       # Register message handler
       server.on_message(agent.handle_message)

       # Start server
       await server.serve(host="0.0.0.0", port=8000)

   if __name__ == "__main__":
       import asyncio
       asyncio.run(main())
   ```

