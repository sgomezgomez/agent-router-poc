   # agent/base.py
   from agent_router.core.config import AgentConfig
   from agent_router.agent.prompt_builder import PromptBuilder
   from agent_router.agent.models import Message, AgentContext
   from typing import List

   class Agent:
       """Reusable base agent class with persona and conversation management."""

       def __init__(self, config: AgentConfig):
           self.config = config
           self.prompt_builder = PromptBuilder(config)
           self.conversation_history: List[Message] = []

       def add_message(self, role: str, content: str):
           """Add message to conversation history."""
           self.conversation_history.append(
               Message(role=role, content=content, timestamp=datetime.utcnow())
           )

       def get_windowed_history(self) -> List[Message]:
           """Get conversation history based on window config."""
           if self.config.message_window == "ALL":
               return self.conversation_history
           elif self.config.message_window.startswith("LAST_"):
               n = int(self.config.message_window.split("_")[1])
               return self.conversation_history[-n:]
           else:
               # Default to last 10
               return self.conversation_history[-10:]

       def build_context(self, query: str, available_tools: List[Dict] | None = None) -> AgentContext:
           """Build agent context for LLM."""
           return AgentContext(
               available_tools=available_tools or [],
               conversation_history=self.get_windowed_history(),
               current_query=query
           )

       def clear_history(self):
           """Clear conversation history."""
           self.conversation_history = []
