```

**Tasks**:
1. Create MCP models
   ```python
   # connectors/mcp/models.py
   from pydantic import BaseModel
   from typing import Dict, Any, List

   class MCPTool(BaseModel):
       name: str
       description: str
       parameters: Dict[str, Any]  # JSON schema
       server: str  # which MCP server provides this

   class MCPToolCall(BaseModel):
       tool_name: str
       parameters: Dict[str, Any]

   class MCPToolResult(BaseModel):
       success: bool
       result: Any | None = None
       error: str | None = None
   ```

2. Create MCP client using official Python SDK (implements ToolConnector interface)
   ```python
   # connectors/mcp/client.py
   from agent_router.core.interfaces import ToolConnector
   from agent_router.connectors.mcp.models import MCPTool, MCPToolResult
   from mcp import ClientSession, StdioServerParameters
   from mcp.client.stdio import stdio_client
   from typing import Dict, List, Any

   class MCPClient(ToolConnector):
       """Client for communicating with MCP servers using official SDK.

       MCP Protocol Overview:
       - Uses JSON-RPC 2.0 for message communication
       - Transports: stdio (local), HTTP/WebSocket (remote)
       - Core methods: initialize, tools/list, tools/call, resources/list, resources/read

       Reference: https://modelcontextprotocol.io/specification/2025-11-25
       """

       def __init__(self, server_name: str, server_config: Dict):
           self.server_name = server_name
           self.server_config = server_config
           self.session: ClientSession | None = None
           self.tools: List[MCPTool] = []

       async def connect(self, config: Dict) -> None:
           """Start MCP server process and discover tools via stdio transport."""
           command = config["command"]
           args = config.get("args", [])

           # Create server parameters for stdio transport
           server_params = StdioServerParameters(
               command=command,
               args=args,
               env=None  # Optional environment variables
           )

           # Connect to MCP server using stdio transport
           async with stdio_client(server_params) as (read, write):
               async with ClientSession(read, write) as session:
                   self.session = session

                   # Initialize connection
                   await session.initialize()

                   # Discover available tools
                   await self._discover_tools()

       async def _discover_tools(self):
           """Query server for available tools using tools/list method."""
           if not self.session:
               raise RuntimeError("Not connected to MCP server")

           # Call tools/list to get available tools
           response = await self.session.list_tools()

           # Convert to our MCPTool models
           self.tools = [
               MCPTool(
                   name=tool.name,
                   description=tool.description,
                   parameters=tool.inputSchema,  # JSON schema
                   server=self.server_name
               )
               for tool in response.tools
           ]

       async def list_tools(self) -> List[MCPTool]:
           """Return list of available tools."""
           return self.tools

       async def execute(self, tool_name: str, parameters: Dict) -> MCPToolResult:
           """Execute a tool call via MCP protocol using tools/call method.

           MCP tools/call request format:
           {
               "jsonrpc": "2.0",
               "id": 1,
               "method": "tools/call",
               "params": {
                   "name": "tool_name",
                   "arguments": {"param": "value"}
               }
           }

           Response format:
           {
               "jsonrpc": "2.0",
               "id": 1,
               "result": {
                   "content": [{"type": "text", "text": "result"}]
               }
           }
           """
           if not self.session:
               return MCPToolResult(success=False, error="Not connected to MCP server")

           try:
               # Call tool using MCP SDK
               response = await self.session.call_tool(
                   name=tool_name,
                   arguments=parameters
               )

               # Extract result from content blocks
               # MCP returns content as array of text/image/resource blocks
               result_data = {
                   "content": [
                       {"type": item.type, "text": item.text if hasattr(item, "text") else None}
                       for item in response.content
                   ]
               }

               return MCPToolResult(success=True, result=result_data)

           except Exception as e:
               return MCPToolResult(success=False, error=str(e))

       async def disconnect(self):
           """Disconnect from MCP server (handled by context managers)."""
           # Connection cleanup is handled by async context managers
           # in the connect() method
           pass
   ```

   **MCP Protocol Notes:**
   - **Transport**: stdio (standard input/output) for local servers
   - **Message Format**: JSON-RPC 2.0 with methods like `tools/list`, `tools/call`
   - **Tool Schema**: Tools have `inputSchema` (JSON Schema) for parameter validation
   - **Content Types**: Responses contain content blocks (text, image, resource)
   - **Session Lifecycle**: initialize → list tools → call tools → disconnect

   **Official SDK Benefits:**
   - Handles JSON-RPC protocol automatically
   - Manages stdio communication
   - Provides typed Python interfaces
   - Handles errors and edge cases

3. Create tool registry
   ```python
   # connectors/mcp/registry.py
   from agent_router.connectors.mcp.client import MCPClient
   from agent_router.connectors.mcp.models import MCPTool
   from typing import List, Dict
   import yaml

   class ToolRegistry:
       """Discovers and manages tools from multiple MCP servers."""

       def __init__(self, mcp_servers_config_path: str = "config/mcp_servers.yaml"):
           self.clients: Dict[str, MCPClient] = {}
           self.all_tools: List[MCPTool] = []
           self.config_path = mcp_servers_config_path

       async def initialize(self):
           """Load config and connect to all enabled MCP servers."""
           with open(self.config_path) as f:
               config = yaml.safe_load(f)

           for server_name, server_config in config.get("servers", {}).items():
               if server_config.get("enabled", False) and server_config.get("type") == "mcp":
                   client = MCPClient(server_config)
                   await client.connect(server_config)
                   self.clients[server_name] = client

                   # Collect tools from this server
                   tools = await client.list_tools()
                   self.all_tools.extend(tools)

       def list_tools(self) -> List[Dict]:
           """Get all tools as dicts for LLM context."""
           return [
               {
                   "name": tool.name,
                   "description": tool.description,
                   "parameters": tool.parameters,
                   "server": tool.server
               }
               for tool in self.all_tools
           ]

       def get_tool(self, tool_name: str) -> MCPTool | None:
           """Get specific tool by name."""
           for tool in self.all_tools:
               if tool.name == tool_name:
                   return tool
           return None

       def get_client_for_tool(self, tool_name: str) -> MCPClient | None:
           """Get the MCP client that provides this tool."""
           tool = self.get_tool(tool_name)
           if tool:
               return self.clients.get(tool.server)
           return None

       async def shutdown(self):
           """Disconnect all MCP clients."""
           for client in self.clients.values():
               await client.disconnect()
   ```

